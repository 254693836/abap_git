@Metadata.layer: #CUSTOMER

@UI: {
  headerInfo: {
    typeName: 'コース',
    typeNamePlural: 'コース一覧',
    title: {
      type: #STANDARD,
      value: 'Name'
    },
    description: {
      value: 'Description'
    }
  }
}

annotate entity zlyz_course_cds_p
  with
{

  @UI.facet: [
    {
      id: 'GeneralInformation',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: '基本情報',
      position: 10
    }
  ]

  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [
    { position: 10, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 10, label: 'ID' }
  ]
  @EndUserText.label: 'ID'
  Id;


  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [
    { position: 20, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 20, label: '名前' }
  ]
  @EndUserText.label: '名前-02'
  Name;


  @UI.lineItem: [
    { position: 30, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 30, label: '説明' }
  ]
  @EndUserText.label: '説明xxx001'
  Description;

}
